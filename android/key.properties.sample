# Copy this file to android/key.properties and fill in your real values.
# Do NOT commit android/key.properties or your keystore file.
#
# storeFile can be absolute or relative to android/ (for example: upload-keystore.jks)
storeFile=upload-keystore.jks
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=upload
keyPassword=CHANGE_ME_KEY_PASSWORD
